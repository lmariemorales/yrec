 $CONTROL

 DESCRIP(1) = "Solar calibration for spotted rotating grid" ! Label for output (optional)
 DESCRIP(2) = "GS98, Kurucz ATM, diffusion, solid-body rotation, vSP13 wind, fast launch" ! Second line label for output (optional)

 ! In addition to X,Y,Z YREC stores light elements (D He3 Li6 Li7 Be9) and CNO isotopes (C12 C13 N14 O16 O18) B10 B11 N15 O17 to be added
 ! These options adjust their relative abundances. It is recommended to tie these to preset mixtures used in opacity tables.
 ! This should be done at the start of a model run, and only work if LFIRST=True.
 ! Option to adjust the CNO mixture to be consistent with the mixture used in the opacity tables
 ISETMIX=0 ! 0 = do not adjust 1 = use specified mixture (AMIX below) 2 = custom mixture (variables at the end of the namelist)
 ! AMIX = 'GS98' ! current implemented solar mixtures are GS98,AAG21,M22P and M22M
 ! Option to adjust the D/He3/Li6/Li7/Be9 abundances and the CNO isotope ratios to be consistent with a specified solar reference
 ISETISO = 0! 0 = do not adjust 1 = use specified mixture (AISO below) 2 = custom mixture (variables at the end of the namelist)
 ! AISO = 'L21' ! Lodders 2021 is currently the only supported mixture, for a different one use the custom option

! Solar calibration (X/Y and alpha to match L and R; Z adjusted to hold surface Z/X). FK is NOT calibrated here - adjust by hand in nml2.
 LCALS = .TRUE. ! Toggle to auto-calibrate solar Y and alpha to match the solar R and L at the age of the Sun.
 LCALSOLZX = .TRUE. ! Enforce correct Z/X for mixture. If this is false Z is held constant in the calibration loop.
 CALSOLZX = 0.02292d0 ! Target solar Z/X (0.02292 is GS98)
 TOLL = 3.0D-5 ! Tolerance target for L in the calibration routines.
 TOLR = 3.0D-5 ! Tolerance target for R in the calibration routines.
 CALSOLAGE = 4.568D9 ! Solar age in the calibration routines.

 NUMRUN = 3 ! Each YREC run can rescale a model, evolve a model, or do both (pre-MS only). This indicates the number of such steps requested.
! Run 1: rescale the D-birthline model and take 2 models (pre-MS, no zero-timestep solution)
 KINDRN(1) = 3 ! 1 = evolve 2= rescale (zero timestep,MS or CHeB); 3 = rescale and evolve (pre-MS, where there is no zero timestep solution)
 LFIRST(1) = .TRUE. ! T = use stored starting model F = use result of prior run
 RSCLM(1) = -1.00 ! If positive, rescale to this mass (Msun)
 RSCLCM(1) = -0.8D0 ! If positive, rescale to this core mass (CHeB only)
 RSCLX(1) = 0.71103 ! Starting guess (rotating gray-atmosphere template calibration) -- If positive, rescale to this hydrogen.
 RSCLZ(1) = 0.01822 ! Starting guess -- If positive, rescale to this metallicity.
 NMODLS(1) = 2 ! Stop after this number of models. An initial rescaling with 2 models is recommended, followed by an evolve run
 XENV0A(1) = 0.71103 ! Envelope abundance label
 ZENV0A(1) = 0.01822 ! Envelope abundance label
 CMIXLA(1) = 1.9028 ! Rescale to this mixing length (or use for the run).
! YREC uses an outer fitting point.
 LSENV0A(1) = .FALSE. ! If true, adjust outer fitting point mass location.
 SENV0A(1) = -1.0D-4 ! Log of fractional envelope fitting point mass. 1e-4 standard, 1e-7 thin
!
! Run 2: evolve through the pre-MS (disk locking ends at 0.281 Myr) to 100 Myr
 KINDRN(2) = 1
 LFIRST(2) = .FALSE.
 NMODLS(2) = 5000 ! Raised from 1000: rotating, disk-locked pre-MS takes many small steps
 XENV0A(2) = 0.71103
 ZENV0A(2) = 0.01822
 CMIXLA(2) = 1.9028
 ENDAGE(2) = 1.0D8 ! Run stops if NMODLS(I) is reached or this age is reached
!
! Run 3: evolve to the solar age
 KINDRN(3) = 1
 LFIRST(3) = .FALSE.
 NMODLS(3) = 5000 ! Must reach ENDAGE before this limit, or the calibration is done at the wrong age
 XENV0A(3) = 0.71103
 ZENV0A(3) = 0.01822
 CMIXLA(3) = 1.9028
 ENDAGE(3) = 4.568D9 ! Run stops if NMODLS(I) is reached or this age is reached

 ! The starting and last models include only abundances and structure variables. These options allow snapshots to be generated with more information.
 LSTORE = .TRUE. ! If T, store model structures at specified points to the .store file.
 LSTCH = .TRUE. ! If T, writes out interior, envelope, and atmosphere output (as controlled by LSTATM and LSTENV) in a single, consistent format (recommended). The default is different formats for each.
 LSTATM = .TRUE. ! If T, append an atmosphere to the stored model file.
 LSTENV = .TRUE. ! If T, append an envelope to the stored model file. If LSTENV and LSTATM = F, no information is output beyond the fitting point.
 LSTMOD = .TRUE. ! Set the same as LSTORE. May be redundant.
 LSTPHYS = .TRUE. ! If T, output microphysics (e.g. epsilon, kappa) to store file.
 LSTROT = .TRUE. ! If T, append rotation data to store file.
 NPRTMOD = 1000 ! Output detailed model structures every NPRTMOD models. Negative = skip intermediate structures (can still output the final model if LSTPCH=T)
 NPRTPT = 1 ! Output details for every NPRTPT points (if 1000 points and NPRTPT=10, 100 lines are output).
 LSTPCH = .TRUE. ! If T, output details of the final model to the .store file.

 LTRACK = .TRUE. ! If T, global properties are output to the .track file. This should almost always be on.
 ITRVER = 0 ! Toggle for different track file formats. 0 (one line per model) strongly recommended.

 LRWSH = .FALSE. ! If T, the short file retains only the details from the last model. This minimizes output file size.
 LCORR = .TRUE. ! If true, output verbose details on model convergence to .short.

 LPULSE = .FALSE. ! If T, generate pulsation output. Off: not needed, and roughly halves output size and run time.
 IPVER = 3 ! Format for pulsation output

! Input files
! Opacity tables and options
 LALEX06 = .TRUE. ! If T, use Ferguson+2005 molecular opacities (recommended)
 FALEX06 = "{YREC_INPUT}/opacity/molecular/alex06/alexmol06gs98.tab" ! Molecular opacity table path
 LOPAL95 = .TRUE. ! If T, use atomic opacities in the OP/OPAL format (recommended).
 ZOPAL951 = 0.01822 ! Generate a surface mixture table with this Z. Speeds up models without diffusion.
 FLIV95 = "{YREC_INPUT}/opacity/atomic/op05/GS98.OP17" ! Atomic opacity table path
 LPUREZ = .TRUE.
 FPUREZ = "{YREC_INPUT}/opacity/atomic/lanl/PURECO.DBGLAOL" ! Pure Y/Z  opacity table path
 FcondOpacP = "{YREC_INPUT}/opacity/conductive/potekhin/condall06.d" ! Conductive opacity table path.

! Equation of state tables
 FOPALE06 = "{YREC_INPUT}/eos/opal2006/EOSOPAL06Z0.018127060" ! OPAL 2006 EoS table path (close to the expected solar Z).
 FATM = "{YREC_INPUT}/atmos/kurucz/atmk1990p00.tab" ! Original Kurucz tables, solar metallicity; used with KTTAU = 3 in nml2.
 FALLARD = "{YREC_INPUT}/atmos/allard/Nextgen2.all" ! Allard model atmosphere look-up table (solar Z only).
 FSCVH = "{YREC_INPUT}/eos/scv/h_tab_i.dat" ! SCZ EoS table for X
 FSCVHE = "{YREC_INPUT}/eos/scv/he_tab_i.dat" ! SCZ EoS table for Y
 FSCVZ = "{YREC_INPUT}/eos/scv/z_tab_i.dat" ! SCZ EoS table for Z (generated from YREC EoS, needed for consistency)
 FFERMI = "{YREC_INPUT}/eos/yale/FERMI.TAB" ! Fermi integral tables for partial degeracy

! Starting models
 FFIRST = "{YREC_START}/dbl/m1000gs98z018804_Dbl.first" ! Sample starting model - Deuterium birthline

! Output files
 FLAST = "{YREC_OUTPUT}/sun_cal.last" ! The last converged model is stored here.
 FSTOR = "{YREC_OUTPUT}/sun_cal.store" ! Model snapshots during the run are stored here.
 FTRACK = "{YREC_OUTPUT}/sun_cal.track" ! Global variables as a function of time are stored here.
 FSHORT = "{YREC_OUTPUT}/sun_cal.short" ! Details about the numerics of the model run are stored here.
 FPMOD = "{YREC_OUTPUT}/sun_cal.pmod" ! Pulsation output for the interior model.
 FPENV = "{YREC_OUTPUT}/sun_cal.penv"! Pulsation output for the envelope model.
 FPATM = "{YREC_OUTPUT}/sun_cal.patm" ! Pulsation output for the atmosphere model.

! Legacy output files
 FMODPT = "{YREC_OUTPUT}/sun_cal.full" ! No longer used.
 FSNU = "{YREC_OUTPUT}/sun_cal.snu" ! No longer used (formally, output if LSNU = T).
 FSCOMP = "{YREC_OUTPUT}/sun_cal.excomp" ! No longer used (light elements vs. time, now included in track file)

! Custom mixture controls - CNO enabled if ISETMIX = 2, Light elements if ISETISO=2

! Total CNO (isotope ratios controlled with ISETISO)
! FRAC_C = 0.172148 ! Mass fraction of metals in the form of carbon; this is the GS98 value
! FRAC_N = 0.050426 ! Mass fraction of metals in the form of nitrogen; this is the GS98 value
! FRAC_O = 0.468195 ! Mass fraction of metals in the form of oxygen; this is the GS98 value

! Isotope ratios and light elements
! R12_13 = 88.27 ! C12/C13 ratio, L21 mix (88.26 L25)
! R14_15 = 411.9 ! N14/N15 ratio, L21 mix (412.3 L25) - placeholder,N15 not currently used
! R16_17 = 471.4 ! O16/O17 ratio, L21 mix (2644 L25)- placeholder,O17 not currently used
! R16_18 = 2693.0 ! O16/O18 ratio, L21 mix (468.2 L25)

! Light element abundances
! XH2_INI = 2.781e-5 ! Initial D mass fraction, L21 mix (2.780e-5 L25)
! XHE3_INI = 3.461e-5 ! Initial D mass fraction, L21 mix (3.443e-5 L25)
! XLI6_INI = 7.187e-10 ! Initial D mass fraction, L21 mix (7.830e-10 L25)
! XLI7_INI = 1.025e-8 ! Initial D mass fraction, L21 mix (1.112e-8 L25)
! XBE9_INI = 1.595e-10 ! Initial D mass fraction, L21 mix (1.810e-10 L25)
! XB10_INI = 1.002e-9 ! Initial D mass fraction, L21 mix (1.099e-9 L25) - placeholder, not currently used
! XB11_INI = 4.405e-9 ! Initial D mass fraction, L21 mix (4.885e-9 L25) - placeholder, not currently used

 $END

